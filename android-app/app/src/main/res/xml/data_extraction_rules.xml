<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: same rules for cloud backup and for moving to a new phone. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="cache/" />
        <exclude domain="root" path="app_webview/Default/HTTP Cache/" />
        <exclude domain="root" path="app_webview/Default/GPUCache/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="cache/" />
        <exclude domain="root" path="app_webview/Default/HTTP Cache/" />
        <exclude domain="root" path="app_webview/Default/GPUCache/" />
    </device-transfer>
</data-extraction-rules>
